            [{"role": "user", "content": prompt}],
            mode="fast",
            user_id=user.id,
        )
        await message.answer(response, reply_markup=reading_menu())
        await state.clear()
    except Exception as e:
        logger.error(f"Reading check error: {e}")
        await message.answer("❌ Tekshirishda xatolik.", reply_markup=reading_menu())
