def word_action_keyboard(word: str) -> InlineKeyboardMarkup:
    """So'z uchun Save va Listen tugmalari."""
    builder = InlineKeyboardBuilder()
    safe_word = word[:50].replace(" ", "_")
    builder.button(text="⭐ Save Word", callback_data=f"save_word:{safe_word}")
    builder.button(text="🔊 Listen", callback_data=f"listen_word:{safe_word}")
    builder.button(text="🔙 Back", callback_data="back_dict")
    builder.adjust(2)
    return builder.as_markup()


