import logging
import json
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from models import User, SpeakingAttempt
from ai_router import ai_router
from prompts import IELTS_SPEAKING_EVALUATOR
from services.memory_service import upsert_memory

logger = logging.getLogger(__name__)

