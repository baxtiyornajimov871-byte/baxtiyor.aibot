# keyboards.py — Barcha inline va reply keyboard tugmalari

from aiogram.types import (
    InlineKeyboardMarkup, InlineKeyboardButton,
    ReplyKeyboardMarkup, KeyboardButton, WebAppInfo
)
from aiogram.utils.keyboard import InlineKeyboardBuilder, ReplyKeyboardBuilder
from config import config


# ===== MAIN MENU =====
def main_menu_keyboard() -> ReplyKeyboardMarkup:
    builder = ReplyKeyboardBuilder()
    buttons = [
        "🧠 AI Chat", "📊 IELTS",
        "📚 CEFR", "🧪 CAT Test",
        "📝 Writing Practice", "🗣 Speaking Practice",
        "🎧 Listening Practice", "📖 Reading Practice",
        "📚 Dictionary", "⭐ My Vocabulary",
        "📈 My Progress", "🎙 Voice Settings",
        "⚙️ Settings", "ℹ️ Help",
    ]
    for btn in buttons:
        builder.button(text=btn)
    builder.adjust(2)
    return builder.as_markup(resize_keyboard=True)


def main_menu_inline() -> InlineKeyboardMarkup:
    """Open Web Version button."""
    builder = InlineKeyboardBuilder()
    builder.button(
        text="🌐 Open Web Version",
        url=config.WEB_APP_URL
    )
    return builder.as_markup()


