async def show_voice_settings(update, state: FSMContext):
    if isinstance(update, CallbackQuery):
        tg_user = update.from_user
        async with AsyncSessionLocal() as db:
            user = await get_or_create_user(db, tg_user)
        kb = voice_settings_keyboard(user.voice_reply_enabled, user.selected_voice_gender)
        await update.message.edit_text(
            "🎙 *Ovoz sozlamalari:*",
