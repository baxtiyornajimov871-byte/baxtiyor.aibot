# handlers/ielts.py — IELTS asosiy handler
import logging
from aiogram import Router, F
from aiogram.types import Message, CallbackQuery
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup

from database import AsyncSessionLocal
from services.user_service import get_or_create_user
from services.writing_service import get_writing_history
from services.speaking_service import get_speaking_history
from services.progress_service import get_progress_data, format_progress_text
from ai_router import ai_router
from keyboards import (
    ielts_menu, writing_menu, speaking_menu,
    listening_menu, reading_menu, back_keyboard,
)

logger = logging.getLogger(__name__)
router = Router()


class IELTSStates(StatesGroup):
    listening_waiting = State()
    reading_waiting = State()
    reading_passage = State()


@router.message(F.text == "📊 IELTS")
async def show_ielts_menu(message: Message, state: FSMContext):
    await state.clear()
    await message.answer("📊 *IELTS bo'limi*", parse_mode="Markdown", reply_markup=ielts_menu())


@router.callback_query(F.data == "ielts_listening")
async def show_listening_menu(callback: CallbackQuery, state: FSMContext):
    await state.clear()
    await callback.message.edit_text(
        "🎧 *IELTS Listening*",
        parse_mode="Markdown",
        reply_markup=listening_menu(),
    )
    await callback.answer()


@router.callback_query(F.data == "ielts_reading")
async def show_reading_menu(callback: CallbackQuery, state: FSMContext):
    await state.clear()
    await callback.message.edit_text(
        "📖 *IELTS Reading*",
        parse_mode="Markdown",
        reply_markup=reading_menu(),
