# ===== VOICE SETTINGS =====
def voice_settings_keyboard(voice_enabled: bool, voice_gender: str) -> InlineKeyboardMarkup:
    builder = InlineKeyboardBuilder()
    toggle_text = "🔊 Voice Reply: ON ✅" if voice_enabled else "🔇 Voice Reply: OFF ❌"
    male_check = "✅" if voice_gender == "male" else ""
    female_check = "✅" if voice_gender == "female" else ""

    builder.button(text=toggle_text, callback_data="voice_toggle")
    builder.button(text=f"👨 Male Voice {male_check}", callback_data="voice_male")
    builder.button(text=f"👩 Female Voice {female_check}", callback_data="voice_female")
    builder.button(text="🎧 Test Voice", callback_data="voice_test")
    builder.button(text="🔙 Back", callback_data="back_main")
    builder.adjust(1)
    return builder.as_markup()


