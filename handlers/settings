# handlers/settings.py — Sozlamalar handler
import logging
from aiogram import Router, F
from aiogram.types import Message, CallbackQuery
from aiogram.fsm.context import FSMContext

from database import AsyncSessionLocal
from services.user_service import get_or_create_user, update_user_field
from services.memory_service import delete_all_memories
from keyboards import (
    settings_menu, language_keyboard, target_exam_keyboard,
    ielts_score_keyboard, cefr_level_keyboard, ai_mode_keyboard,
    voice_settings_keyboard, confirm_keyboard, back_keyboard,
)

logger = logging.getLogger(__name__)
router = Router()


@router.message(F.text == "⚙️ Settings")
@router.callback_query(F.data == "back_settings")
async def show_settings(update, state: FSMContext):
    await state.clear()
    if isinstance(update, Message):
        await update.answer("⚙️ *Sozlamalar*", parse_mode="Markdown", reply_markup=settings_menu())
    else:
        await update.message.edit_text("⚙️ *Sozlamalar*", parse_mode="Markdown", reply_markup=settings_menu())
        await update.answer()


@router.callback_query(F.data == "settings_language")
