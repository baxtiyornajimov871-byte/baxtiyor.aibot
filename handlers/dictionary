@router.message(DictStates.waiting_translate)
@router.message(DictStates.waiting_auto)
async def handle_auto_translate(message: Message, state: FSMContext):
    text = message.text
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, message.from_user)

    try:
        result = await translate_text(text, user_id=user.id)
        formatted = format_translation(result)
        await message.answer(formatted, parse_mode="Markdown", reply_markup=dictionary_menu())
        await state.clear()
    except Exception as e:
        logger.error(f"Translation error: {e}")
        await message.answer("❌ Tarjimada xatolik.", reply_markup=dictionary_menu())
        await state.clear()


