# handlers/dictionary.py — Lug'at va tarjima handler
import logging
from aiogram import Router, F
from aiogram.types import Message, CallbackQuery
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup

from database import AsyncSessionLocal
from services.user_service import get_or_create_user
from services.translator_service import (
    translate_text, explain_word, format_translation, format_word_explanation, detect_language
)
from services.vocabulary_service import save_word
from services.voice_service import voice_service
from keyboards import dictionary_menu, word_action_keyboard, back_keyboard

logger = logging.getLogger(__name__)
router = Router()


class DictStates(StatesGroup):
    waiting_translate = State()
    waiting_word = State()
    waiting_en_uz = State()
    waiting_uz_en = State()
    waiting_auto = State()


@router.message(F.text == "📚 Dictionary")
@router.callback_query(F.data == "back_dict")
async def show_dict_menu(update, state: FSMContext):
    await state.clear()
    if isinstance(update, Message):
        await update.answer("📚 *Lug'at va Tarjima*", parse_mode="Markdown", reply_markup=dictionary_menu())
    else:
        await update.message.edit_text("📚 *Lug'at va Tarjima*", parse_mode="Markdown", reply_markup=dictionary_menu())
        await update.answer()


