# services/vocabulary_service.py — Lug'at va vocabulary boshqaruvi
import logging
import random
from datetime import datetime
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, func
from models import User, VocabularyWord
from ai_router import ai_router

logger = logging.getLogger(__name__)


async def save_word(
    db: AsyncSession,
    user: User,
    word: str,
    translation: str = "",
    example_en: str = "",
    example_uz: str = "",
    part_of_speech: str = "",
    cefr_level: str = "",
) -> VocabularyWord:
    """So'zni lug'atga saqlaydi."""
    # Allaqachon saqlangan?
    existing = await db.execute(
        select(VocabularyWord).where(
            VocabularyWord.user_id == user.id,
            VocabularyWord.word == word.lower().strip(),
        )
    )
    existing = existing.scalar_one_or_none()
    if existing:
        return existing

    vocab = VocabularyWord(
        user_id=user.id,
        word=word.lower().strip(),
        translation=translation,
        example_sentence=example_en,
        example_translation=example_uz,
        part_of_speech=part_of_speech,
        cefr_level=cefr_level,
    )
    db.add(vocab)
    await db.commit()
    await db.refresh(vocab)
    logger.info(f"Word saved: {word} for user {user.id}")
    return vocab


async def get_saved_words(db: AsyncSession, user: User, limit: int = 20, offset: int = 0) -> list[VocabularyWord]:
    result = await db.execute(
        select(VocabularyWord)
        .where(VocabularyWord.user_id == user.id)
        .order_by(VocabularyWord.saved_at.desc())
        .limit(limit)
        .offset(offset)
    )
    return result.scalars().all()


async def get_words_for_review(db: AsyncSession, user: User, limit: int = 10) -> list[VocabularyWord]:
    """Ko'rib chiqish kerak bo'lgan so'zlarni qaytaradi (kam o'rganiganlar)."""
    result = await db.execute(
        select(VocabularyWord)
        .where(VocabularyWord.user_id == user.id)
        .order_by(VocabularyWord.review_count.asc(), VocabularyWord.saved_at.asc())
        .limit(limit)
    )
    return result.scalars().all()


async def mark_word_reviewed(db: AsyncSession, word: VocabularyWord):
    """So'z ko'rib chiqildi deb belgilaydi."""
    word.review_count += 1
    word.last_reviewed_at = datetime.utcnow()
    await db.commit()


async def delete_word(db: AsyncSession, user: User, word_id: int):
    result = await db.execute(
        select(VocabularyWord).where(
            VocabularyWord.id == word_id,
            VocabularyWord.user_id == user.id,
        )
    )
    word = result.scalar_one_or_none()
    if word:
        await db.delete(word)
        await db.commit()


async def get_word_count(db: AsyncSession, user: User) -> int:
    result = await db.execute(
        select(func.count(VocabularyWord.id)).where(VocabularyWord.user_id == user.id)
    )
    return result.scalar_one()


async def generate_quiz_question(word: VocabularyWord) -> dict:
    """So'z uchun quiz savol yaratadi."""
    prompt = f"""Create a multiple choice vocabulary quiz question for the word "{word.word}".
    Translation: {word.translation}
    Example: {word.example_sentence}
    
    Respond ONLY in JSON:
    {{
      "question": "What does '{word.word}' mean?",
      "correct": "{word.translation}",
      "options": ["{word.translation}", "wrong1", "wrong2", "wrong3"],
      "explanation": "Short explanation..."
    }}"""

    response = await ai_router.chat(
        [{"role": "user", "content": prompt}],
        mode="economy",
    )
    result = await ai_router.parse_json_response(response)
    # Options ni aralashtirish
    options = result.get("options", [result["correct"]])
    random.shuffle(options)
    result["shuffled_options"] = options
    return result


async def export_vocabulary_text(db: AsyncSession, user: User) -> str:
    """Barcha so'zlarni matn shaklida eksport qiladi."""
    words = await get_saved_words(db, user, limit=500)
    if not words:
        return "Lug'atingizda hali so'z yo'q."

    lines = [f"📚 {user.first_name} ning lug'ati\n{'='*40}\n"]
    for i, w in enumerate(words, 1):
        line = f"{i}. {w.word}"
        if w.translation:
            line += f" — {w.translation}"
        if w.cefr_level:
            line += f" [{w.cefr_level}]"
        if w.example_sentence:
            line += f"\n   📌 {w.example_sentence}"
        lines.append(line)

    return "\n".join(lines)
