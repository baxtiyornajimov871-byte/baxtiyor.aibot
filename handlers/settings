    await callback.answer()


@router.callback_query(F.data == "voice_test")
async def test_voice(callback: CallbackQuery):
    from services.voice_service import voice_service
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, callback.from_user)

    await callback.answer("🔊 Ovoz tayyorlanmoqda...")

    audio_path = await voice_service.text_to_speech(
        "Hello! This is a test voice message from Baxtiyor AI.",
        voice_gender=user.selected_voice_gender,
    )
    if audio_path:
        try:
            with open(audio_path, "rb") as f:
                await callback.message.answer_voice(f, caption="🎧 Test ovoz")
        finally:
            voice_service.cleanup_file(audio_path)
    else:
        await callback.message.answer(
            "❌ TTS API sozlanmagan. .env faylida TTS_API_KEY ni kiriting."
        )


