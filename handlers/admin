@router.callback_query(F.data == "admin_broadcast")
async def start_broadcast(callback: CallbackQuery, state: FSMContext):
    if not is_admin(callback.from_user.id):
        await callback.answer("⛔ Ruxsat yo'q.", show_alert=True)
        return
    
    await state.set_state(AdminStates.waiting_broadcast)
    await callback.message.edit_text(
        "📢 *Broadcast xabar*\n\nBarcha foydalanuvchilarga yuboriladigan xabarni yozing:\n\n"
        "(Bekor qilish uchun /cancel)",
        parse_mode="Markdown",
    )
    await callback.answer()


@router.message(AdminStates.waiting_broadcast, F.text)
async def send_broadcast(message: Message, state: FSMContext):
    if not is_admin(message.from_user.id):
        await state.clear()
        return

    broadcast_text = message.text
    if broadcast_text.startswith("/cancel"):
        await state.clear()
        await message.answer("❌ Bekor qilindi.")
        return

    await state.clear()
    await message.answer("📤 Yuborilmoqda...")

    async with AsyncSessionLocal() as db:
        users = await get_all_users(db)

    success = 0
    failed = 0
    for user in users:
        try:
            await message.bot.send_message(
                user.telegram_id,
                f"📢 *Xabar:*\n\n{broadcast_text}",
                parse_mode="Markdown",
            )
            success += 1
        except Exception as e:
            logger.warning(f"Broadcast failed for {user.telegram_id}: {e}")
            failed += 1

    await message.answer(
        f"✅ Broadcast yakunlandi!\n"
        f"Muvaffaqiyatli: {success}\n"
        f"Muvaffaqiyatsiz: {failed}"
    )


@router.callback_query(F.data == "admin_users")
async def show_users(callback: CallbackQuery):
    if not is_admin(callback.from_user.id):
        await callback.answer("⛔ Ruxsat yo'q.", show_alert=True)
        return

    async with AsyncSessionLocal() as db:
        users = await get_all_users(db)

    text = f"👥 *Foydalanuvchilar* ({len(users)} ta)\n\n"
    for u in users[-20:]:  # So'nggi 20 ta
        name = u.first_name or "No name"
        username = f"@{u.username}" if u.username else "—"
        text += f"• {name} ({username}) — {u.target_exam} {u.target_score}\n"

    await callback.message.edit_text(
        text,
        parse_mode="Markdown",
        reply_markup=admin_menu(),
    )
    await callback.answer()


@router.callback_query(F.data == "admin_logs")
async def show_logs(callback: CallbackQuery):
    if not is_admin(callback.from_user.id):
        await callback.answer("⛔ Ruxsat yo'q.", show_alert=True)
        return

    from sqlalchemy import select
    from models import UsageLog

    async with AsyncSessionLocal() as db:
        result = await db.execute(
            select(UsageLog)
            .order_by(UsageLog.created_at.desc())
            .limit(10)
        )
        logs = result.scalars().all()

    if not logs:
        await callback.message.edit_text("📋 Log yo'q.", reply_markup=admin_menu())
        await callback.answer()
        return

    text = "📋 *So'nggi loglar:*\n\n"
    for log in logs:
        status_em = "✅" if log.status == "success" else "❌"
        date = log.created_at.strftime("%d.%m %H:%M")
        text += f"{status_em} {date} | {log.action} | {log.tokens_used}t\n"

    await callback.message.edit_text(
        text,
        parse_mode="Markdown",
        reply_markup=admin_menu(),
    )
    await callback.answer()


