@router.callback_query(F.data.startswith("set_lang:"))
async def set_language(callback: CallbackQuery):
    lang = callback.data.split(":")[1]
    lang_names = {"uz": "O'zbek", "en": "English", "ru": "Русский"}
    
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, callback.from_user)
        await update_user_field(db, user, preferred_language=lang)

    await callback.message.edit_text(
        f"✅ Til o'zgartirildi: *{lang_names.get(lang, lang)}*",
        parse_mode="Markdown",
        reply_markup=back_keyboard("back_settings"),
    )
    await callback.answer()


