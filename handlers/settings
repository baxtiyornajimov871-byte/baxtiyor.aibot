    else:
        async with AsyncSessionLocal() as db:
            user = await get_or_create_user(db, update.from_user)
        kb = voice_settings_keyboard(user.voice_reply_enabled, user.selected_voice_gender)
        await update.answer(
            "🎙 *Ovoz sozlamalari:*",
            parse_mode="Markdown",
            reply_markup=kb,
        )


@router.callback_query(F.data == "voice_toggle")
async def toggle_voice(callback: CallbackQuery):
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, callback.from_user)
        new_state = not user.voice_reply_enabled
        await update_user_field(db, user, voice_reply_enabled=new_state)

    status = "✅ yoqildi" if new_state else "❌ o'chirildi"
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, callback.from_user)
    kb = voice_settings_keyboard(user.voice_reply_enabled, user.selected_voice_gender)
    await callback.message.edit_text(
        f"🎙 Ovozli javob {status}\n\n*Ovoz sozlamalari:*",
        parse_mode="Markdown",
        reply_markup=kb,
    )
    await callback.answer()


@router.callback_query(F.data.in_({"voice_male", "voice_female"}))
