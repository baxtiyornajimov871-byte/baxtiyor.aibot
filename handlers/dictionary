@router.message(DictStates.waiting_word)
async def handle_word_explain(message: Message, state: FSMContext):
    word = message.text.strip()
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, message.from_user)

    await message.answer("⏳ So'z tahlil qilinmoqda...")

    try:
        result = await explain_word(word, user_id=user.id)
        # Word data ni state ga saqlash (save uchun)
        await state.update_data(
            last_word=result.get("word", word),
            last_translation=result.get("translation_uz", ""),
            last_example_en=result.get("example_en", ""),
            last_example_uz=result.get("example_uz", ""),
            last_pos=result.get("part_of_speech", ""),
            last_cefr=result.get("cefr_level", ""),
        )
        
        formatted = format_word_explanation(result)
        await message.answer(
            formatted,
            parse_mode="Markdown",
            reply_markup=word_action_keyboard(result.get("word", word)),
        )
        await state.clear()

    except Exception as e:
        logger.error(f"Word explain error: {e}")
        await message.answer("❌ So'zni tushuntirishda xatolik.", reply_markup=dictionary_menu())
        await state.clear()


@router.callback_query(F.data.startswith("save_word:"))
async def save_word_handler(callback: CallbackQuery, state: FSMContext):
    word = callback.data.split(":", 1)[1].replace("_", " ")

    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, callback.from_user)
        vocab = await save_word(db, user, word)

    if vocab:
        await callback.answer(f"⭐ '{word}' lug'atga saqlandi!", show_alert=False)
    else:
        await callback.answer("So'z allaqachon saqlangan.", show_alert=False)


@router.callback_query(F.data.startswith("listen_word:"))
async def listen_word_handler(callback: CallbackQuery):
    word = callback.data.split(":", 1)[1].replace("_", " ")
    
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, callback.from_user)

    await callback.answer("🔊 Ovoz tayyorlanmoqda...")

    audio_path = await voice_service.text_to_speech(
        word,
        voice_gender=user.selected_voice_gender,
    )
    if audio_path:
        try:
            with open(audio_path, "rb") as f:
                await callback.message.answer_voice(f, caption=f"🔊 {word}")
        finally:
            voice_service.cleanup_file(audio_path)
    else:
        await callback.message.answer("❌ Ovoz yaratib bo'lmadi. TTS sozlamalari kerak.")
