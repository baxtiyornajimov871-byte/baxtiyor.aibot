# ===== TELEGRAM =====
BOT_TOKEN=your_telegram_bot_token_here

# ===== DATABASE =====
# SQLite (local uchun):
DATABASE_URL=sqlite+aiosqlite:///bot.db

# PostgreSQL (Render uchun):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ===== AI API KEYS =====
# OpenAI yoki boshqa OpenAI-compatible provider
AI_API_KEY_1=sk-your-first-api-key
AI_API_KEY_2=sk-your-second-api-key
AI_API_KEY_3=sk-your-third-api-key

# AI Models
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_STRONG=gpt-4o
AI_MODEL_CHEAP=gpt-3.5-turbo

# API Base URL (OpenAI default)
AI_BASE_URL=https://api.openai.com/v1

# ===== STT/TTS =====
# OpenAI Whisper va TTS uchun (AI_API_KEY_1 ishlatiladi agar bo'sh qoldirilsa)
STT_API_KEY=
TTS_API_KEY=
STT_PROVIDER=openai
TTS_PROVIDER=openai

# ===== ADMIN =====
# Telegram user ID larini vergul bilan ajrating
ADMIN_IDS=123456789,987654321

# ===== WEB APP =====
WEB_APP_URL=https://baxtiyor-ai.onrender.com/

# ===== APP =====
DEFAULT_LANGUAGE=uz
LOG_LEVEL=INFO
