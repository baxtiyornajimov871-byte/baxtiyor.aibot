# services/writing_service.py — IELTS Writing baholash
import logging
import json
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from models import User, WritingAttempt
from ai_router import ai_router
from prompts import IELTS_WRITING_EVALUATOR
from services.memory_service import upsert_memory

logger = logging.getLogger(__name__)


async def evaluate_writing(
    db: AsyncSession,
    user: User,
    essay_text: str,
    task_type: str = "task2",
    prompt_text: str = "",
) -> dict:
    """IELTS writing essayni baholaydi va natijani saqlaydi."""
    
    # Oldingi urinishni topish
    prev = await get_last_writing_attempt(db, user)
    prev_score = prev.estimated_score if prev else "N/A"
    prev_mistakes = json.dumps(prev.mistakes_json) if prev and prev.mistakes_json else "[]"

    # AI evaluation
    prompt = IELTS_WRITING_EVALUATOR.format(
        task_type=task_type,
        prompt=prompt_text or "General IELTS task",
        essay=essay_text,
        prev_score=prev_score,
        prev_mistakes=prev_mistakes,
    )

    response = await ai_router.chat_strong(
        [{"role": "user", "content": prompt}],
        user_id=user.id,
        json_mode=True,
    )

    result = await ai_router.parse_json_response(response)

    # Ma'lumotlar bazasiga saqlash
    attempt = WritingAttempt(
        user_id=user.id,
        exam_type="IELTS",
        task_type=task_type,
        prompt=prompt_text,
        essay_text=essay_text,
        estimated_score=result.get("estimated_score"),
        task_response_score=result.get("task_response_score"),
        coherence_score=result.get("coherence_score"),
        lexical_score=result.get("lexical_score"),
        grammar_score=result.get("grammar_score"),
        mistakes_json=result.get("mistakes", []),
        improvements_json=result.get("improvements_from_previous", []),
        feedback=result.get("feedback"),
        improved_version=result.get("improved_version"),
    )
    db.add(attempt)
    await db.commit()

    # User xotirasini yangilash
    score = result.get("estimated_score", 0)
    await upsert_memory(db, user, "last_writing_score", str(score), "score")
    
    still_weak = result.get("still_weak", [])
    if still_weak:
        user.weak_areas = ", ".join(still_weak[:5])
        await db.commit()

    result["previous_score"] = prev_score
    return result


async def get_last_writing_attempt(db: AsyncSession, user: User) -> WritingAttempt | None:
    result = await db.execute(
        select(WritingAttempt)
        .where(WritingAttempt.user_id == user.id)
        .order_by(WritingAttempt.created_at.desc())
        .limit(1)
    )
    return result.scalar_one_or_none()


async def get_writing_history(db: AsyncSession, user: User, limit: int = 10) -> list[WritingAttempt]:
    result = await db.execute(
        select(WritingAttempt)
        .where(WritingAttempt.user_id == user.id)
        .order_by(WritingAttempt.created_at.desc())
        .limit(limit)
    )
    return result.scalars().all()


async def generate_writing_topic(user_profile: dict, task_type: str = "task2") -> str:
    """Foydalanuvchi profiliga mos writing topic yaratadi."""
    interests = user_profile.get("interests", "general topics")
    level = user_profile.get("current_level", "B1")

    prompt = f"""Generate an IELTS {task_type} writing topic suitable for a {level} student interested in {interests}.
    
    Respond with ONLY the topic text, no additional explanation.
    For task2, give a complete essay question (agree/disagree or discuss both views).
    For task1_academic, describe a graph/chart/diagram scenario.
    For task1_general, give a letter writing scenario."""

    response = await ai_router.chat(
        [{"role": "user", "content": prompt}],
        mode="fast",
    )
    return response.strip()


def format_writing_result(result: dict, prev_score) -> str:
    """Writing natijasini chiroyli matn shaklida qaytaradi."""
    score = result.get("estimated_score", "N/A")
    tr = result.get("task_response_score", "N/A")
    cc = result.get("coherence_score", "N/A")
    lr = result.get("lexical_score", "N/A")
    gr = result.get("grammar_score", "N/A")

    improvement_text = ""
    if prev_score != "N/A" and isinstance(score, (int, float)) and isinstance(prev_score, (int, float)):
        diff = round(float(score) - float(prev_score), 1)
        if diff > 0:
            improvement_text = f"\n📈 *Yaxshilanish:* oldingi {prev_score} → hozir {score} (+{diff})"
        elif diff < 0:
            improvement_text = f"\n📉 *O'zgarish:* oldingi {prev_score} → hozir {score} ({diff})"
        else:
            improvement_text = f"\n➡️ *O'zgarish yo'q:* {score} (oldingi bilan bir xil)"

    mistakes = result.get("mistakes", [])
    mistakes_text = "\n".join([f"  • {m}" for m in mistakes[:5]]) if mistakes else "  Jiddiy xato topilmadi"

    improvements = result.get("improvements_from_previous", [])
    imp_text = "\n".join([f"  ✅ {i}" for i in improvements]) if improvements else "  —"

    still_weak = result.get("still_weak", [])
    weak_text = "\n".join([f"  ⚠️ {w}" for w in still_weak]) if still_weak else "  —"

    text = f"""📝 *IELTS Writing Natija*
{'─' * 35}
🏆 *Umumiy ball:* {score}/9.0
📋 Task Response: {tr}
🔗 Coherence & Cohesion: {cc}
📚 Lexical Resource: {lr}
📐 Grammar: {gr}
{improvement_text}

❌ *Asosiy xatolar:*
{mistakes_text}

✨ *Yaxshilangan tomonlar:*
{imp_text}

🎯 *Hali zaif tomonlar:*
{weak_text}

💬 *Baho:*
{result.get('feedback', '')}
"""
    return text
