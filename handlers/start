    await state.clear()
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, message.from_user)
    
    name = message.from_user.first_name or "Do'stim"
    text = f"👋 *Assalomu alaykum, {name}!*\n\n" + WELCOME_TEXT.split("\n\n", 1)[1]
    
    await message.answer(
        text,
        parse_mode="Markdown",
        reply_markup=main_menu_keyboard(),
    )
    await message.answer(
        "🌐 Veb versiyani ham ochishingiz mumkin:",
        reply_markup=main_menu_inline(),
    )


