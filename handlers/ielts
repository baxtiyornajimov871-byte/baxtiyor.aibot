@router.callback_query(F.data == "ielts_progress")
async def show_ielts_progress(callback: CallbackQuery):
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, callback.from_user)
        data = await get_progress_data(db, user)
        text = format_progress_text(data, user)

    await callback.message.edit_text(
        text,
        parse_mode="Markdown",
        reply_markup=back_keyboard("back_ielts"),
    )
    await callback.answer()


