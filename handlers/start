@router.message(Command("memory"))
async def cmd_memory(message: Message):
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, message.from_user)
        memories = await get_all_memories(db, user)

    if not memories:
        await message.answer(
            "🧠 Hozircha xotiramda hech narsa yo'q. Menga o'zingiz haqingizda gapirsangiz, eslab qolaman!",
            parse_mode="Markdown",
        )
        return

    # Kategoriya bo'yicha guruhlab ko'rsatish
    by_cat: dict[str, list] = {}
    for m in memories:
        cat = m.category or "general"
        by_cat.setdefault(cat, []).append(m)

    text = "🧠 *Xotiramda saqlangan ma'lumotlar:*\n\n"
    emoji_map = {
        "personal": "👤",
        "goal": "🎯",
        "score": "📊",
        "weakness": "⚠️",
        "strength": "✅",
        "preference": "⚙️",
        "general": "📝",
    }
    for cat, items in by_cat.items():
        em = emoji_map.get(cat, "📌")
        text += f"{em} *{cat.capitalize()}:*\n"
        for item in items:
            text += f"  • {item.key}: {item.value}\n"
        text += "\n"

    profile_text = (
        f"👤 *Profil:*\n"
        f"  Ism: {user.first_name}\n"
        f"  Maqsad: {user.target_exam} {user.target_score}\n"
        f"  Daraja: {user.current_level}\n"
        f"  Zaif: {user.weak_areas or '—'}\n"
        f"  Kuchli: {user.strong_areas or '—'}\n"
        f"  Qiziqishlar: {user.interests or '—'}\n"
    )
    text = profile_text + "\n" + text

    await message.answer(text, parse_mode="Markdown")


@router.message(Command("forget"))
async def cmd_forget(message: Message):
    await message.answer(
        "⚠️ *Xotirani o'chirish*\n\n"
        "Barcha saqlangan ma'lumotlar, chat tarixi va natijalar o'chiriladi.\n"
        "Bu amalni qaytarib bo'lmaydi!\n\n"
        "Davom etasizmi?",
        parse_mode="Markdown",
        reply_markup=confirm_keyboard("forget_memory"),
    )


@router.callback_query(F.data == "confirm:forget_memory")
async def confirm_forget(callback: CallbackQuery):
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, callback.from_user)
        await delete_all_memories(db, user)

    await callback.message.edit_text(
        "✅ Barcha xotira o'chirildi. Yangi boshlanish! 🔄\n\n"
        "Menga o'zingiz haqingizda yana gapirsangiz, eslab qolaman.",
        reply_markup=back_keyboard("back_main"),
    )
    await callback.answer()


@router.message(Command("progress"))
async def cmd_progress(message: Message):
    await message.answer("⏳ Progress ma'lumotlaringiz yuklanmoqda...")
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(db, message.from_user)
        data = await get_progress_data(db, user)
        text = format_progress_text(data, user)

    await message.answer(text, parse_mode="Markdown")
    
    # AI tahlil
    try:
        async with AsyncSessionLocal() as db:
            user = await get_or_create_user(db, message.from_user)
            ai_analysis = await generate_progress_report(db, user)
        await message.answer(f"🤖 *AI tahlili:*\n\n{ai_analysis}", parse_mode="Markdown")
    except Exception as e:
        logger.error(f"Progress AI analysis error: {e}")


